# ─── Backend Environment Variables ──────────────────────────────
# Copy this file to .env and fill in values for your environment.
# DO NOT commit .env — it is excluded by .gitignore.

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Local Development: mongodb://127.0.0.1:27017/gradeyourself
# Production Atlas:  mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/gradeyourself?retryWrites=true&w=majority
# NOTE: In production (e.g. Render/Railway/Fly), set MONGO_URI in your hosting platform's environment variables.
MONGO_URI=mongodb://127.0.0.1:27017/gradeyourself

# JWT Secret — MUST be replaced with a cryptographically secure random string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_secure_random_secret_min_64_chars

# Token lifetime (e.g. 24h, 7d, 30d)
JWT_EXPIRES_IN=24h

# Frontend origin — used for CORS in production
# Example: https://app.example.com
FRONTEND_URL=http://localhost:5173

# Cookie SameSite attribute (lax, strict, none) — defaults to lax in dev, strict in prod
COOKIE_SAME_SITE=lax

# Gemini Multimodal Vision API Key for Document Extraction & Table Parsing
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

